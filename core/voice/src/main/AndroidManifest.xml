<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dictation and voice conversations; asked for when first used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A voice conversation keeps the microphone and its speech while the app is out of sight. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The phone's own speech engines, which Android 11+ hides unless named. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
        <!-- Read aloud on the lock screen, going on while the app is out of sight. -->
        <service
            android:name=".ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
