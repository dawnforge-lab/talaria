<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: the recent chats ChatShortcuts publishes show in the share sheet and open ShareActivity. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="lab.dawnforge.hermes.share.ShareActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="*/*" />
        <category android:name="lab.dawnforge.hermes.category.SHARE_TO_CHAT" />
    </share-target>
</shortcuts>
