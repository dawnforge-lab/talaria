<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device through Auto Backup or device-to-device transfer: the app keeps
    dashboard credentials and tokens, and its Keystore keys would not survive a restore anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
